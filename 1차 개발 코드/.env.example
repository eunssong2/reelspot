NODE_ENV=development
HOST=127.0.0.1
PORT=8081
DATABASE_URL=postgres://atp:atp-local-only@127.0.0.1:55432/atp
TOKEN_SECRET=replace-with-at-least-32-random-characters
DATA_SECRET=replace-with-a-different-32-character-secret
CURSOR_SECRET=replace-with-another-32-character-secret
OBJECT_ROOT=.data/objects
PUBLIC_URL=https://sphan0325.ddns.net
CORS_ORIGINS=https://sphan0325.ddns.net:5173
AUTH_MODE=development
MODERATION_MODE=review
OPS_MODE=development
DEV_OPS_TOKEN=replace-local-operator-secret
# Google Web application OAuth client. Secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sphan0325.ddns.net/v1/auth/google/callback
# Signing certificate fingerprint (not a private key). Use Play App Signing certificate for Play builds.
ANDROID_APP_SHA256=
KAKAO_APP_ID=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# Must exactly match the Kakao console Redirect URI; blank uses PUBLIC_URL + callback path.
KAKAO_REDIRECT_URI=https://sphan0325.ddns.net/v1/auth/kakao/callback
# Public map key and registered WebView website origin only. Never use the Admin key here.
EXPO_PUBLIC_KAKAO_JS_KEY=
EXPO_PUBLIC_KAKAO_WEB_ORIGIN=https://sphan0325.ddns.net
OPS_ISSUER=
OPS_AUDIENCE=
MODERATION_URL=
MODERATION_TOKEN=
SUPPORT_EMAIL=

PLACES_PROVIDER=kakao
GOOGLE_PLACES_API_KEY=
