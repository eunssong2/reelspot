{
  "expo": {
    "name": "At that place",
    "slug": "at-that-place",
    "version": "0.1.0",
    "scheme": "atthatplace",
    "platforms": [
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "kr.atthatplace.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "함께할 순간을 촬영하려면 카메라가 필요해요.",
          "microphonePermission": "소리 있는 영상을 촬영하려면 마이크가 필요해요.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
