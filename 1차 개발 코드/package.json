{
  "name": "at-that-place",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "contracts",
    "ops-web"
  ],
  "scripts": {
    "dev": "tsx watch server/api/main.ts",
    "emulator:fast": "node scripts/start-emulator.mjs",
    "worker": "tsx server/worker/main.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "contracts": "node scripts/contract-extensions.mjs && openapi-typescript contracts/openapi.json -o contracts/generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "tsc && npm run build -w ops-web",
    "ops": "npm run dev -w ops-web",
    "setup": "node scripts/setup.mjs",
    "test:mobile-policy": "tsx --test mobile/tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
