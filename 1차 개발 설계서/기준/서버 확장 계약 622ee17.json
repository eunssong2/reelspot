      "patch": {
        "operationId": "visitUpdate",
        "summary": "expectedVersion + 이름·주소·위치·방문 시간 또는 providerPlaceId(교체) → VisitDetail",
        "tags": [
          "F09",
          "F10"
        ],
        "description": "권한: member. 생략한 값은 유지하고 null은 주소·위치·시간을 지운다. 정보 수정은 방문별 수기 사본에 저장해 다른 방문과 공급자 원본을 바꾸지 않는다. providerPlaceId는 이름·주소·위치와 함께 보낼 수 없고 기록·미완료 업로드가 있으면 거부한다. 도메인 오류: VERSION_CONFLICT VISIT_HAS_RECORDS DUPLICATE_VISIT PLACE_SEARCH_REQUIRED VALIDATION_ERROR TEXT_REJECTED SCHEDULE_CANCELLED DAY_CANCELLED EXPIRED DELETED.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "visitId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "address": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 800
                  },
                  "location": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lng": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "lat",
                      "lng"
                    ]
                  },
                  "plannedTime": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "providerPlaceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "expectedVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "방문과 교체 가능 여부·날짜 계획 버전",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDetail"
                }
              }
            }
          },
          "400": {
