          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "visit",
        "replaceable",
        "editable",
        "planVersion"
      ]
    },
    "Visit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scheduleId": {
          "type": "string",
          "format": "uuid"
        },
        "placeId": {
          "type": "string",
          "format": "uuid"
        },
        "visitDate": {
          "type": "string",
          "format": "date"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "plannedTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "00:00~23:59 1분 단위. null=시간 미정"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lng": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "scheduleId",
        "placeId",
        "visitDate",
        "position",
        "version"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "currentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "details": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true,
          "description": "OUTSIDE_RANGE_CONFIRMATION_REQUIRED: {visits,media}; MEDIA_LIMIT: {photosRemaining,videosRemaining}; VISIT_LIMIT: {limit:15}; SCHEDULE_DATE_TAKEN: {dates:[date],schedules:[{id,title}]}; DAY_CANCELLED: {date}; TARGET_NOT_EMPTY: {date}; DUPLICATE_FILE: {clientFileIds:[...]}"
        },
        "itemErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "field": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": []
          }
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "retryable"
      ]
    },
    "Invitation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "link": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{8}$|^[0-9A-F]{12}$",
          "description": "신규: 0/O/1/I 제외 8자. 기존 발급 코드는 만료까지 허용"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "useCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maxUses": {
          "type": "integer",
          "const": 50
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "exhausted",
            "expired",
            "revoked"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "link",
        "code",
        "issuedAt",
        "expiresAt",
        "useCount",
        "maxUses",
        "state",
        "version"
      ]
    },
    "Media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scheduleId": {
          "type": "string",
          "format": "uuid"
        },
        "authorUserId": {
          "type": "string",
          "format": "uuid"
        },
        "submissionId": {
          "type": "string",
          "format": "uuid"
        },
        "selectionIndex": {
          "type": "integer"
        },
        "recordDate": {
          "type": "string",
          "format": "date"
        },
        "visitId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "photo",
            "video"
          ]
        },
        "durationMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "capturedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "촬영 시각. 표시·필터용으로 보존하며 정렬에 쓰지 않는다"
        },
        "submissionCompletedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sortAt": {
          "type": "string",
          "format": "date-time"
        },
        "sortBasis": {
          "type": "string",
          "enum": [
            "submission"
          ],
          "description": "v3.1 Q16 추가 설계·PM 확인 대기: 임시 정렬 기준은 게시 묶음(submission)의 첫 완료 시각(submissionCompletedAt=sortAt). 같은 묶음 안에서는 selectionIndex 순서 유지"
        },
        "retentionLastDate": {
          "type": "string",
          "format": "date"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "accessState": {
          "type": "string",
          "enum": [
            "available",
            "deleted",
            "expired",
            "restricted"
          ]
        },
        "visitName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "scheduleId",
        "authorUserId",
        "submissionId",
        "selectionIndex",
        "recordDate",
        "kind",
        "completedAt",
        "submissionCompletedAt",
        "sortAt",
        "sortBasis",
        "version",
        "accessState"
      ]
    },
    "UploadTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "targetType": {
          "type": "string",
          "enum": [
            "record",
            "cover",
            "avatar"
          ]
        },
        "submissionId": {
          "type": "string",
          "format": "uuid"
        },
        "coverGroupId": {
          "type": "string",
          "format": "uuid"
        },
        "avatarUserId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "uploading",
            "verifying",
            "review",
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "transferredBytes": {
          "type": "integer",
          "minimum": 0
        },
        "actualBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "mediaId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/UploadTransport"
            },
            {
              "type": "null"
            }
          ]
        },
        "clientFileId": {
          "type": "string"
        },
        "coverAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "avatarAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectionIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 119
        }
      },
      "required": [
        "id",
        "targetType",
        "state",
        "transferredBytes",
        "actualBytes",
        "retryable",
        "reason",
        "version",
        "mediaId",
        "transport",
        "coverAssetId",
        "clientFileId",
        "selectionIndex"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "targetType": {
              "const": "record"
            }
          },
          "required": [
            "submissionId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "coverGroupId"
                ]
              },
              {
                "required": [
                  "avatarUserId"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "targetType": {
              "const": "cover"
            }
          },
          "required": [
            "coverGroupId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "submissionId"
                ]
              },
              {
                "required": [
                  "avatarUserId"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "targetType": {
              "const": "avatar"
            }
          },
          "required": [
            "avatarUserId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "submissionId"
                ]
              },
              {
                "required": [
                  "coverGroupId"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "complete",
                  "cancelled",
                  "verifying",
                  "review"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "targetType": {
                "const": "record"
              }
            }
          },
          "then": {
            "required": [
              "clientFileId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              },
              "targetType": {
                "const": "record"
              }
            }
          },
          "then": {
            "properties": {
              "mediaId": {
                "type": "string",
                "format": "uuid"
              },
              "coverAssetId": {
                "type": "null"
              },
              "avatarAssetId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              },
              "targetType": {
                "const": "cover"
              }
            }
          },
          "then": {
            "properties": {
              "coverAssetId": {
                "type": "string",
                "format": "uuid"
              },
              "mediaId": {
                "type": "null"
              },
              "avatarAssetId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              },
              "targetType": {
                "const": "avatar"
              }
            }
          },
          "then": {
            "required": [
              "avatarAssetId"
            ],
            "properties": {
              "avatarAssetId": {
                "type": "string",
                "format": "uuid"
              },
              "mediaId": {
                "type": "null"
              },
              "coverAssetId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "UploadTransport": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "ATP-Upload/1"
        },
        "uploadEndpoint": {
          "type": "string",
          "format": "uri-reference"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "resumeOffset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "alignmentBytes": {
          "type": "integer",
          "const": 1048576
        },
        "maxChunkBytes": {
          "type": "integer",
          "const": 4194304
        }
      },
      "required": [
        "protocol",
        "uploadEndpoint",
        "generation",
        "resumeOffset",
        "length",
        "expiresAt",
        "alignmentBytes",
        "maxChunkBytes"
      ],
      "additionalProperties": false
    }
  }
}
