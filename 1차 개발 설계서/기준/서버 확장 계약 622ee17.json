  "schemas": {
    "VisitDetail": {
      "type": "object",
      "properties": {
        "visit": {
          "$ref": "#/components/schemas/Visit"
        },
        "replaceable": {
          "type": "boolean",
          "description": "숨김·검토·보존 기록과 미완료 업로드가 없어 다른 장소로 교체할 수 있음"
        },
        "editable": {
          "type": "boolean",
          "description": "취소·만료가 아니어서 수정할 수 있음"
        },
